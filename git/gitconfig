# Include local configuration for user-specific settings
# This keeps personal data outside of version control
[include]
    path = ~/.gitconfig.local

[core]
	autocrlf = input
	excludesfile = ~/.gitignore_global
	compression = 9
[gpg]
	program = /usr/local/bin/gpg
[commit]
	gpgsign = false
[tag]
	forceSignAnnotated = false
[init]
	defaultBranch = develop

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true


    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    last = log -1 HEAD
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[http]
	version = HTTP/1.1
	postBuffer = 524288000
[credential]
	helper = osxkeychain
[push]
	autoSetupRemote = true

# CodeRabbit configuration (optional)
# Uncomment and set your machine ID if using CodeRabbit
# [coderabbit]
# 	machineId = cli/YOUR_MACHINE_ID

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
